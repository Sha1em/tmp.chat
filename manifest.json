{
  "manifest_version": 3,
  "name": "tmp.chat",
  "version": "0.1.7",
  "description": "Explore a tangent beside your ChatGPT conversation, using your own ChatGPT account.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "scripting", "alarms"],
  "host_permissions": ["https://chatgpt.com/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Open tmp.chat on ChatGPT" },
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*"],
    "js": ["lib/core.js", "lib/selection.js", "lib/layout.js", "content.js"],
    "run_at": "document_idle",
    "all_frames": false
  }],
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
